{
  "name": "queryverdict",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-native SQL workspace that measures join evidence locally. Production application (see docs/ARCHITECTURE.md).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/vendor-extensions.mjs && vite build && node scripts/check-artifact.mjs dist",
    "build:harness": "node scripts/vendor-extensions.mjs && vite build --config vite.harness.config.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:harness": "vite preview --config vite.harness.config.ts --port 4174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "vendor": "node scripts/vendor-extensions.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:artifact": "node scripts/check-artifact.mjs dist",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "parse5": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
